{
  "name": "suta",
  "description": "UI guidelines and code for 57 patterns for Claude Code and Codex. Includes layout, color, motion and accessibility guidance, with checks after supported file edits.",
  "version": "0.13.0",
  "author": { "name": "Guksu", "url": "https://github.com/Guksu" },
  "homepage": "https://guksu.github.io/suta/",
  "repository": "https://github.com/Guksu/suta",
  "license": "MIT",
  "keywords": ["ai-slop", "frontend", "ui", "layout", "animation", "interaction", "accessibility", "css", "react"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/suta/scripts/post-edit-hook.mjs\"", "timeout": 30 }]
      }
    ]
  }
}
