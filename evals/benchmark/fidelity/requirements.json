        {"id":"R10","kind":"수치","text":"카드 그림자 0 2px 8px rgba(0,0,0,0.08)","conflict":{"rule":"elevation(놓인 것은 그림자 없이)","class":"취향","default":"놓인 카드는 그림자 없이 톤 차이로"},"check":{"type":"style","viewport":390,"target":{"unit":["소금빵","우유식빵","크루아상","딸기 생크림 케이크","바닐라 라떼","앙버터"]},"property":"box-shadow","expect":{"shadow":{"y":2,"blur":8,"alpha":0.08}}}},
        {"id":"R11","kind":"데이터","text":"메뉴 여섯 개의 이름과 가격","check":{"type":"text","viewport":390,"target":{"unit":["소금빵","우유식빵","크루아상","딸기 생크림 케이크","바닐라 라떼","앙버터"]},"expect":{"containsEach":["3,500원","5,800원","4,200원","32,000원","5,000원","4,800원"]}}},
