        {"id":"R16","kind":"상호작용","text":"'장바구니에 담았어요' 알림이 떴다가 2초 뒤 사라진다(스크린 리더에도 전달)","check":{"type":"timing","viewport":390,"steps":[{"do":"click","target":{"role":"button","name":"담기","nth":0}}],"target":{"text":"장바구니에 담았어요"},"expect":{"visibleWithinMs":300,"goneBetweenMs":[1700,2600],"liveRegion":true}}},
